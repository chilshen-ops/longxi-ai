{
  "name": "KSR-tiny（可运行原型：与 ksr7b_32L 定稿同构，只是缩小）",
  "_note": "结构与定稿一致：全 MHA、混合注意力（1 全 + 1 线性）、常识专家常驻、低秩旁路专家、序列级纠错。参数量 ~7M，CPU 上可训练、可端到端验证四条主张。词表由语料构建，实际大小由 tokenizer 决定。",
  "vocab_size": 512,
  "hidden_size": 256,
  "num_layers": 2,
  "num_attention_heads": 4,
  "num_kv_groups": 4,
  "head_dim": 64,
  "full_attn_layers": [1],
  "linear_attn": {
    "num_kv_groups": 4,
    "num_v_heads": 4,
    "head_dim_k": 64,
    "head_dim_v": 64
  },
  "ffn_type": "swiglu",
  "reasoner_hidden": 512,
  "num_skill_experts": 4,
  "expert_rank": 64,
  "expert_ffn_type": "swiglu",
  "top_k_experts": 1,
  "router_hidden": 128,
  "corrector": {
    "enabled": true,
    "placement": "sequence",
    "hidden": 256,
    "num_classes": 3,
    "with_correction_proj": true,
    "always_on": false,
    "token_wrong_ratio": 0.25,
    "confidence_low": 0.5
  },
  "tied_embeddings": true,
  "context_len": 512,
  "rope_theta": 10000.0,
  "quant": {
    "attention": "fp32",
    "reasoner": "fp32",
    "router": "fp32",
    "experts": "fp32",
    "embedding": "fp32",
    "kv_cache": "fp32",
    "corrector": "fp32"
  },
  "hot_experts": 4,
  "link": { "bandwidth_gbps": 50.0 },
  "runtime_overhead_bytes": 0,
  "kb_top_k": 2,
  "kb_max_tokens_per_segment": 48,
  "kb_max_total_tokens": 96,
  "router_confidence_low": 0.35,
  "aux_loss_weight": 0.01,
  "limits": {}
}
