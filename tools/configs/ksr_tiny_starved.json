{
  "name": "KSR-tiny-starved（消融：把共享通路调窄、专家调宽）",
  "_note": "上一轮实测：故意把答案塞给错误的专家，准确率仍然是 100%——因为常驻常识专家（reasoner_hidden=512）容量远大于低秩专家（rank=64），模型不需要选对专家就能把题答对，路由就没有分工的压力。这个配置把容量关系反过来：共享通路 512→64（窄 8 倍），专家秩 64→256（宽 4 倍）。其余全部不变。这样共享通路装不下四个领域，路由必须分工，'选错专家'才会真的答错——这是检验'专家解耦'这条主张最干净的消融。",
  "vocab_size": 512,
  "hidden_size": 256,
  "num_layers": 2,
  "num_attention_heads": 4,
  "num_kv_groups": 4,
  "head_dim": 64,
  "full_attn_layers": [1],
  "linear_attn": {
    "num_kv_groups": 4,
    "num_v_heads": 4,
    "head_dim_k": 64,
    "head_dim_v": 64
  },
  "ffn_type": "swiglu",
  "reasoner_hidden": 64,
  "num_skill_experts": 4,
  "expert_rank": 256,
  "expert_ffn_type": "swiglu",
  "top_k_experts": 1,
  "router_hidden": 128,
  "corrector": {
    "enabled": true,
    "placement": "sequence",
    "hidden": 256,
    "num_classes": 3,
    "with_correction_proj": true,
    "always_on": false,
    "token_wrong_ratio": 0.25,
    "confidence_low": 0.5
  },
  "tied_embeddings": true,
  "context_len": 512,
  "rope_theta": 10000.0,
  "quant": {
    "attention": "fp32",
    "reasoner": "fp32",
    "router": "fp32",
    "experts": "fp32",
    "embedding": "fp32",
    "kv_cache": "fp32",
    "corrector": "fp32"
  },
  "hot_experts": 4,
  "link": { "bandwidth_gbps": 50.0 },
  "runtime_overhead_bytes": 0,
  "kb_top_k": 2,
  "kb_max_tokens_per_segment": 48,
  "kb_max_total_tokens": 96,
  "router_confidence_low": 0.35,
  "aux_loss_weight": 0.01,
  "limits": {}
}
