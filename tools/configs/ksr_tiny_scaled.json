{
  "name": "KSR-tiny-scaled（容量受限任务：16 领域 × 10 意图）",
  "_note": "上一轮实测：4 领域 × 6 题时故意选错专家仍然 100%，共享通路砍到 64 也一样——任务太简单，任何专家都没参与，所以测不出路由的价值。这个配置配合 16 领域、160 条映射、16 套互不相干词表的任务，把共享通路保持很窄（reasoner=64），专家 16 个、每个秩 128：共享通路约 0.1M 参数，可路由参数约 3.1M。只有在这种容量分配下，'选错专家'才会真的答错，路由分工才有可测的收益。评测同时给出'固定只用专家 0'的对照（等价于没有路由的稠密模型）。",
  "vocab_size": 512,
  "hidden_size": 256,
  "num_layers": 2,
  "num_attention_heads": 4,
  "num_kv_groups": 4,
  "head_dim": 64,
  "full_attn_layers": [1],
  "linear_attn": {
    "num_kv_groups": 4,
    "num_v_heads": 4,
    "head_dim_k": 64,
    "head_dim_v": 64
  },
  "ffn_type": "swiglu",
  "reasoner_hidden": 64,
  "num_skill_experts": 16,
  "expert_rank": 128,
  "expert_ffn_type": "swiglu",
  "top_k_experts": 1,
  "router_hidden": 128,
  "corrector": {
    "enabled": true,
    "placement": "sequence",
    "hidden": 256,
    "num_classes": 3,
    "with_correction_proj": true,
    "always_on": false,
    "token_wrong_ratio": 0.25,
    "confidence_low": 0.5
  },
  "tied_embeddings": true,
  "context_len": 512,
  "rope_theta": 10000.0,
  "quant": {
    "attention": "fp32",
    "reasoner": "fp32",
    "router": "fp32",
    "experts": "fp32",
    "embedding": "fp32",
    "kv_cache": "fp32",
    "corrector": "fp32"
  },
  "hot_experts": 16,
  "link": { "bandwidth_gbps": 50.0 },
  "runtime_overhead_bytes": 0,
  "kb_top_k": 2,
  "kb_max_tokens_per_segment": 48,
  "kb_max_total_tokens": 96,
  "router_confidence_low": 0.35,
  "aux_loss_weight": 0.01,
  "router_supervision_weight": 0.5,
  "limits": {}
}
