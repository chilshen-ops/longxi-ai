{
  "name": "KSR-180M（结构等比：用于和同参数量稠密模型做实测对照）",
  "_note": "选 180M 这个尺度是有原因的：2-4M 的原型上，路由和各模块的调用开销远大于 FLOP 节省，实测反而比稠密慢（0.21-0.44×），那个数字不能用来谈效率。180M 时矩阵乘才占主导，decode 吞吐的差距才反映架构差异。结构与 7B 定稿一致：混合注意力（只有 4k+1 层全注意力）、常驻常识专家、低秩旁路专家栈、路由。",
  "vocab_size": 32000,
  "hidden_size": 1024,
  "num_layers": 12,
  "num_attention_heads": 16,
  "num_kv_groups": 16,
  "head_dim": 64,
  "full_attn_layers": [1, 5, 9],
  "linear_attn": {
    "num_kv_groups": 16,
    "num_v_heads": 16,
    "head_dim_k": 64,
    "head_dim_v": 64
  },
  "ffn_type": "swiglu",
  "reasoner_hidden": 512,
  "num_skill_experts": 8,
  "expert_rank": 256,
  "expert_ffn_type": "swiglu",
  "top_k_experts": 1,
  "router_hidden": 256,
  "corrector": {
    "enabled": true,
    "placement": "sequence",
    "hidden": 512,
    "num_classes": 3,
    "with_correction_proj": true,
    "always_on": false,
    "token_wrong_ratio": 0.25,
    "confidence_low": 0.5
  },
  "tied_embeddings": true,
  "context_len": 4096,
  "rope_theta": 10000.0,
  "quant": {
    "attention": "int4g32",
    "reasoner": "int4g32",
    "router": "fp16",
    "experts": "int4g32",
    "embedding": "int4g32",
    "kv_cache": "fp16",
    "corrector": "fp16"
  },
  "hot_experts": 8,
  "link": { "bandwidth_gbps": 50.0 },
  "runtime_overhead_bytes": 0,
  "kb_top_k": 3,
  "kb_max_tokens_per_segment": 64,
  "kb_max_total_tokens": 192,
  "router_confidence_low": 0.35,
  "router_confidence_high": 0.85,
  "aux_loss_weight": 0.01,
  "router_supervision_weight": 0.5,
  "limits": {}
}
